{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Readers Paradise API",
			"type": "shell",
			"command": "./backend/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--reload",
				"--app-dir",
				"backend",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Readers Paradise frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}